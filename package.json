{
  "name": "tiro-live-bilingual-caption-workspace",
  "version": "0.1.0",
  "description": "Real-time English-to-Korean bilingual caption & presentation workspace for Windows 10/11",
  "main": "dist-electron/main.js",
  "author": "Live Translate Workspace",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:start": "npm run build:electron && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npm run electron:start\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "smoke": "npm run build && electron . --smoke-test",
    "poc:verify": "npm run build && electron . --poc-verify",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
